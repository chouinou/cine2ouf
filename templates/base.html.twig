<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Cine2ouf{% endblock %}</title>

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>

        <header class="entete">
            <div class="conteneur entete-contenu">
                <a href="{{ path('app_films') }}" class="logo">Ciné<span>2ouf</span></a>
                <nav class="menu">
                    <a href="{{ path('app_films') }}"
                       class="{{ app.current_route in ['app_films', 'app_film', 'app_realisateur', 'app_reservation'] ? 'actif' }}">Films</a>
                    <a href="{{ path('app_salles') }}"
                       class="{{ app.current_route == 'app_salles' ? 'actif' }}">Salles</a>
                </nav>
            </div>
        </header>

        <main class="conteneur">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alerte alerte-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="pied">
            <div class="conteneur pied-contenu">
                <span>Cine2ouf le cinéma du 19e</span>
                <span>Tarif réduit à 9,50 € sur les séances avant 18 h</span>
            </div>
        </footer>

    </body>
</html>